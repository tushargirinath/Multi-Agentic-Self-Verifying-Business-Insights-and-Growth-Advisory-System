# MAVIS Environment Configuration Template
ANTHROPIC_API_KEY=
MAVIS_MODEL=claude-3-5-sonnet-20241022

# LLM Providers (OpenRouter Free Models & Ollama)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=liquid/lfm-2.5-2.6b:free
OLLAMA_API_KEY=your_ollama_api_key_here
OLLAMA_BASE_URL=http://localhost:11434
LLM_PROVIDER=openrouter

# Runtime Budgets
MAVIS_MAX_STEPS=12
MAVIS_MAX_TOKENS=60000
MAVIS_MAX_SECONDS=90
MAVIS_MAX_REPAIRS=3

# Storage & Privacy
MAVIS_SANDBOX_MODE=local
MAVIS_TOKEN_SALT=mavis_secret_salt_2026_salt_token
MAVIS_DATA_DIR=data/lakehouse
MAVIS_RAW_DATA_PATH=data/raw/sales_transactions.csv
MAVIS_CRITIC_TOLERANCE=0.005
MAVIS_DB_URL=sqlite:///data/mavis_app.db
